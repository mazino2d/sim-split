# Local build settings, read with `flutter run --dart-define-from-file=.env.local`.
# Copy this file to .env.local (gitignored) and fill in the values you have.
# Never commit real values: this repo is public.

# App Check debug token (a UUID) for debug builds. Ask the maintainer for the
# shared token registered in everything-as-code, or leave it empty: the SDK
# then prints a token of its own that you register in the Firebase console.
APP_CHECK_DEBUG_TOKEN=

# Talk to the local Firebase emulators instead of production
# (`npx firebase-tools emulators:start`). Leave empty for the real backend.
FIREBASE_EMULATOR_HOST=
