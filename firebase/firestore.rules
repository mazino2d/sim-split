rules_version = '2';

// R-3 co-worked groups. Spec: docs/product/specs/R-3-online-shared-groups.md
//
// A group and everything under it is visible only to its members, the uids
// in `memberUids` (AC23). Every member may change anything in the group,
// but not who is in it, except to leave. Activity entries can only be
// created (AC28); they disappear only with a group whose last member
// deletes it. R-7: only the owner archives or reopens a group, and an
// archived group is read-only (#117).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // R-4: every group read and write needs the account's profile, which the
    // app stores when the account first signs in and so agrees to the privacy
    // policy. Builds without it (2026.10.22) can no longer sync.
    function agreed() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function groupPath(g) {
      return /databases/$(database)/documents/groups/$(g);
    }

    // A member before the write (reading, leaving) or after it (a group is
    // created together with its first records in one batch).
    function memberBefore(g) {
      return agreed() && exists(groupPath(g))
        && request.auth.uid in get(groupPath(g)).data.memberUids;
    }

    function memberAfter(g) {
      return agreed() && existsAfter(groupPath(g))
        && request.auth.uid in getAfter(groupPath(g)).data.memberUids;
    }

    function soleMember(g) {
      return agreed() && exists(groupPath(g))
        && get(groupPath(g)).data.memberUids == [request.auth.uid];
    }

    // Every synced write names its author and carries the server time, so
    // the last write to reach the server wins (AC17).
    function stamped() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validGroup(g) {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.currencyCode is string
        && data.memberUids is list && data.ownerUid is string
        && data.get('settlementMode', 'simplified') in ['hub', 'simplified']
        && validCollector(g);
    }

    // R-7 #116: the collector of "through one person" settlements is null
    // (the owner's member) or a member of the group. Checked only when it
    // changes, so other edits cost no extra read.
    function validCollector(g) {
      let after = request.resource.data.get('settlementHubMemberId', null);
      let before = resource == null ? null : resource.data.get('settlementHubMemberId', null);
      return after == null || after == before
        || (after is string
          && existsAfter(/databases/$(database)/documents/groups/$(g)/members/$(after)));
    }

    // R-7 #117: an archived group is read-only, and only its owner archives
    // or reopens it. A group without the field is not archived.
    function archivedAfter(g) {
      return getAfter(groupPath(g)).data.get('isArchived', false) == true;
    }

    // R-8: an archived group's own document is read-only too. While archived,
    // only the owner reopening it or a member leaving changes it; the last
    // member can still delete it (allow delete below).
    function archivedBefore() {
      return resource.data.get('isArchived', false) == true;
    }

    function reopening() {
      return resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('isArchived', false) == false
        && changedKeys().hasOnly(['isArchived', 'updatedAt', 'updatedBy']);
    }

    function archiveUnchangedOrOwner() {
      return request.resource.data.get('isArchived', false) == resource.data.get('isArchived', false)
        || resource.data.ownerUid == request.auth.uid;
    }

    // Leaving removes only yourself; an owner who leaves hands the group to
    // a remaining member.
    function leaving() {
      let before = resource.data;
      let after = request.resource.data;
      let uid = request.auth.uid;
      return after.memberUids == before.memberUids.removeAll([uid])
        && after.memberUids.size() > 0
        && ((before.ownerUid != uid && after.ownerUid == before.ownerUid)
          || (before.ownerUid == uid && after.ownerUid in after.memberUids));
    }

    // Joining with the group's current invite token (AC10, AC13) adds only
    // yourself; the token is sent as `joinToken`.
    function joining() {
      let before = resource.data;
      let after = request.resource.data;
      let uid = request.auth.uid;
      return !(uid in before.memberUids)
        && before.get('isArchived', false) != true
        && before.get('inviteToken', null) != null
        && after.get('joinToken', null) == before.inviteToken
        && after.memberUids == before.memberUids.concat([uid])
        && changedKeys().hasOnly(['memberUids', 'joinToken', 'updatedAt', 'updatedBy'])
        && stamped();
    }

    // Any member creates the first invite link; only the owner replaces it
    // (AC13). The link's invite document is written in the same batch.
    function validInviteChange() {
      let before = resource.data.get('inviteToken', null);
      let after = request.resource.data.get('inviteToken', null);
      return after == before
        || (after is string && after.size() >= 20
          && (before == null || resource.data.ownerUid == request.auth.uid)
          && existsAfter(/databases/$(database)/documents/invites/$(after)));
    }

    match /groups/{g} {
      allow read: if agreed() && request.auth.uid in resource.data.memberUids;

      allow create: if agreed() && stamped() && validGroup(g)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if agreed() && request.auth.uid in resource.data.memberUids
        && stamped() && validGroup(g) && validInviteChange() && archiveUnchangedOrOwner()
        && (!changedKeys().hasAny(['memberUids', 'ownerUid']) || leaving())
        && (!archivedBefore() || reopening() || leaving());

      allow update: if agreed() && joining();

      allow delete: if agreed() && resource.data.memberUids == [request.auth.uid];
    }

    match /groups/{g}/{collection}/{id} {
      function synced() {
        return collection in ['members', 'expenses', 'settlements'];
      }

      // A member can be claimed only while unclaimed, and only by yourself;
      // you can only release your own claim.
      function validClaim() {
        let before = resource == null ? null : resource.data.get('linkedUid', null);
        let after = request.resource.data.get('linkedUid', null);
        return after == before
          || (before == null && after == request.auth.uid)
          || (before == request.auth.uid && after == null);
      }

      // R-8: free text is bounded. A value that doesn't change passes, so a
      // record written before a limit existed can still be edited or deleted.
      function textAtMost(field, max) {
        let value = request.resource.data.get(field, null);
        return value == null
          || (value is string && value.size() <= max)
          || (resource != null && resource.data.get(field, null) == value);
      }

      // Money is integer cents, never a float (AC21).
      function validRecord() {
        let data = request.resource.data;
        return collection == 'members'
          ? data.name is string && data.name.size() > 0 && data.name.size() <= 80 && validClaim()
            && textAtMost('emoji', 16)
          : collection == 'expenses'
            ? data.amountCents is int && data.splits is list && data.splits.size() <= 100
              && textAtMost('title', 200) && textAtMost('note', 2000) && textAtMost('category', 40)
            : data.amountCents is int && textAtMost('note', 2000);
      }

      // Leaving an archived group still releases your own member.
      function releasingOwnClaim() {
        return collection == 'members' && resource != null
          && resource.data.get('linkedUid', null) == request.auth.uid
          && request.resource.data.get('linkedUid', null) == null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['linkedUid', 'updatedBy', 'updatedAt']);
      }

      allow read: if synced() && memberBefore(g);
      allow create, update: if synced() && (memberBefore(g) || memberAfter(g))
        && stamped() && validRecord()
        && (!archivedAfter(g) || releasingOwnClaim());
      allow delete: if synced() && soleMember(g);
    }

    // An invite link's token names its group. It can be read only by token
    // (never listed), by anyone signed in who has the link.
    match /invites/{token} {
      allow get: if agreed();
      allow create: if agreed()
        && request.resource.data.keys().hasOnly(['groupId'])
        && memberAfter(request.resource.data.groupId)
        && getAfter(groupPath(request.resource.data.groupId)).data.inviteToken == token;
      // The owner removes a replaced link, or the link of a group they delete.
      allow delete: if agreed()
        && get(groupPath(resource.data.groupId)).data.ownerUid == request.auth.uid;
    }

    // R-9: what the account wants to be notified about. Every field is
    // optional (a missing one is the default in crm/categories.yaml); the
    // sender reads it at send time.
    function validNotificationPrefs(p) {
      return p is map
        && p.keys().hasOnly(['groupActivity', 'settleReminder', 'updates', 'mutedGroups'])
        && p.get('groupActivity', false) is bool
        && p.get('settleReminder', false) is bool
        && p.get('updates', false) is bool
        && p.get('mutedGroups', []) is list
        && p.get('mutedGroups', []).size() <= 200;
    }

    // R-4: the account's profile and the privacy policy revision it agreed
    // to by signing in. Only the account itself can read, create or delete
    // it, and the agreement can never be changed afterwards. R-7 #112: the
    // account may set the name it goes by in groups; R-9: and its
    // notification choices and the in-app banners it dismissed. Nothing else.
    match /users/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && changedKeys().hasOnly(['memberName', 'notificationPrefs', 'dismissedAnnouncements'])
        && (!('memberName' in changedKeys())
          || (request.resource.data.memberName is string
            && request.resource.data.memberName.size() > 0
            && request.resource.data.memberName.size() <= 80))
        && (!('notificationPrefs' in changedKeys())
          || validNotificationPrefs(request.resource.data.notificationPrefs))
        && (!('dismissedAnnouncements' in changedKeys())
          || (request.resource.data.dismissedAnnouncements is list
            && request.resource.data.dismissedAnnouncements.size() <= 100));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt', 'consent'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.consent.keys().hasOnly(['agreedAt', 'policyVersion'])
        && request.resource.data.consent.agreedAt == request.time
        && request.resource.data.consent.policyVersion is string;
    }

    // R-9: the account's devices that get push notifications, one per app
    // install (a random ID, not the R-4 error report ID). Only the account
    // reads or changes them; the sender reads them with the Admin SDK. They
    // are deleted on sign-out (this device) and before the profile when the
    // account is deleted (all of them), since deleting users/{uid} keeps
    // its subcollections.
    match /users/{uid}/devices/{deviceId} {
      function validDevice() {
        let d = request.resource.data;
        return d.keys().hasOnly(['token', 'platform', 'locale', 'tzName',
            'tzOffsetMinutes', 'appVersion', 'updatedAt'])
          && d.keys().hasAll(['token', 'platform', 'locale', 'tzName',
            'tzOffsetMinutes', 'appVersion', 'updatedAt'])
          && d.token is string && d.token.size() > 0 && d.token.size() <= 4096
          && d.platform in ['android', 'web']
          && d.locale in ['en', 'vi']
          && d.tzName is string && d.tzName.size() > 0 && d.tzName.size() <= 64
          && d.tzOffsetMinutes is int
          && d.tzOffsetMinutes >= -720 && d.tzOffsetMinutes <= 840
          && d.appVersion is string && d.appVersion.size() > 0 && d.appVersion.size() <= 40
          && d.updatedAt == request.time;
      }

      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && deviceId.size() <= 64 && validDevice();
    }

    // R-9 AC12: in-app banners, written only by services/crm (Admin SDK).
    // A signed-in account reads one addressed to everyone or to itself;
    // the app queries exactly those two cases. Clients never write.
    match /announcements/{id} {
      allow read: if signedIn()
        && (resource.data.all == true || request.auth.uid in resource.data.audienceUids);
    }

    match /groups/{g}/activity/{a} {
      // R-8: an entry has the shape the app writes: a known action on a known
      // kind of record, and snapshots whose free text is bounded like the
      // records themselves.
      function snapshotOk(s) {
        return s == null || (s is map && s.keys().size() <= 40
          && (s.get('title', '') is string && s.get('title', '').size() <= 200)
          && (s.get('note', null) == null || (s.note is string && s.note.size() <= 2000))
          && (s.get('name', '') is string && s.get('name', '').size() <= 100));
      }

      function validEntry() {
        let data = request.resource.data;
        return data.keys().hasOnly(['actorUid', 'action', 'entityType', 'entityId',
            'before', 'after', 'clientTime', 'syncedAt'])
          && data.action in ['create', 'update', 'delete', 'join']
          && data.entityType in ['group', 'member', 'expense', 'settlement']
          && data.entityId is string && data.entityId.size() <= 128
          && snapshotOk(data.get('before', null))
          && snapshotOk(data.get('after', null));
      }

      allow read: if memberBefore(g);
      allow create: if (memberBefore(g) || memberAfter(g))
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.syncedAt == request.time
        && request.resource.data.clientTime is int
        && validEntry();
      allow delete: if soleMember(g);
    }
  }
}
